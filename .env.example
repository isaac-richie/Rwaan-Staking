# BSC RPC URL (Mainnet)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Alchemy RPC (primary + backups, server-side only)
BSC_ALCHEMY_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_ALCHEMY_RPC_URL2=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY_2

# Deployer private key (NEVER commit this!)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# BSCScan API key for contract verification
BSCSCAN_API_KEY=your_bscscan_api_key_here

# WalletConnect Cloud project id (required for Trust Wallet via WalletConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
